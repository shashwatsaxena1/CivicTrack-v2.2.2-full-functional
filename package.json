{
  "name": "civictrack-v2",
  "private": true,
  "version": "2.2.2",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @civictrack/api --filter @civictrack/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @civictrack/api db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:seed-admin": "pnpm --filter @civictrack/api db:seed-admin"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
